root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
trim_trailing_whitespace = false

[*.py]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{cpp,h,hpp,c,ino}]
indent_style = space
indent_size = 2

[*.{toml,ini,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false